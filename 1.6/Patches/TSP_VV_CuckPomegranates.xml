				<li Class="PatchOperationRemove">
					<success>Always</success>
					<xpath>Defs/RecipeDef/defaultIngredientFilter/thingDefs/li[text()="VV_Pomegranates"]</xpath>
				</li>
				
				<li Class="PatchOperationReplace">
					<success>Always</success>
					<xpath>Defs/ThingDef/costList/VV_Pomegranates</xpath>
					<value>
						<AR_RawPomegranate MayRequire="mlie.ancientrimcore">5</AR_RawPomegranate>
					</value>
				</li>
				
				<li Class="PatchOperationRemove">
					<success>Always</success>
					<xpath>Defs/ThingDef[defName="VV_Pomegranates"]</xpath>
				</li>
				
				<li Class="PatchOperationReplace">
					<success>Always</success>
					<xpath>Defs/ThingDef[defName="VV_PomegranateTree"]/plant/harvestedThingDef</xpath>
