					<value>
						<li MayRequire="mlie.ancientrimcore">AR_RawPomegranate</li>
					</value>
				</li>
				
				<li Class="PatchOperationInsert">
					<xpath>Defs/RecipeDef/fixedIngredientFilter/thingDefs/li[text()="VV_Pomegranates"]</xpath>
					<success>Always</success>
					<value>
						<li MayRequire="mlie.ancientrimcore">AR_RawPomegranate</li>
					</value>
				</li>
				
				<li Class="PatchOperationInsert">
					<xpath>Defs/RecipeDef/defaultIngredientFilter/thingDefs/li[text()="VV_Pomegranates"]</xpath>
					<success>Always</success>
					<value>
						<li MayRequire="mlie.ancientrimcore">AR_RawPomegranate</li>
					</value>
				</li>
				
				<li Class="PatchOperationInsert">
					<xpath>Defs/RecipeDef/ingredients/li/filter/thingDefs/li[text()="VV_Pomegranates"]</xpath>
					<success>Always</success>
					<value>
						<li MayRequire="mlie.ancientrimcore">AR_RawPomegranate</li>
					</value>
				</li>
				
				<li Class="PatchOperationInsert">
					<xpath>Defs/RecipeDef/fixedIngredientFilter/thingDefs/li[text()="VV_Pomegranates"]</xpath>
					<success>Always</success>
					<value>
						<li MayRequire="mlie.ancientrimcore">AR_RawPomegranate</li>
					</value>
				</li>
				
				<li Class="PatchOperationInsert">
					<xpath>Defs/RecipeDef/defaultIngredientFilter/thingDefs/li[text()="VV_Pomegranates"]</xpath>
					<success>Always</success>
					<value>
						<li MayRequire="mlie.ancientrimcore">AR_RawPomegranate</li>
					</value>
				</li>
				
				<li Class="PatchOperationInsert">
					<xpath>Defs/ThingDef/plant/sowResearchPrerequisites/li[text()="VV_Pomegranates"]</xpath>
					<success>Always</success>
					<value>
						<li MayRequire="mlie.ancientrimcore">AR_RawPomegranate</li>
					</value>
				</li>
				
