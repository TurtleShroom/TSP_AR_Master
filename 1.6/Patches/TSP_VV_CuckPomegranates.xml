						<harvestedThingDef MayRequire="mlie.ancientrimcore">AR_RawPomegranate</harvestedThingDef>
					</value>
				</li>
				
				<li Class="PatchOperationReplace">
					<success>Always</success>
					<xpath>Defs/ThingDef[defName="VV_PomegranateTree"]/plant/sowTags</xpath>
